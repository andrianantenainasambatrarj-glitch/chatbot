# Copiez en .env.local pour surcharger en développement.
# Laissez VIDE en développement : le proxy de Create React App (clé "proxy"
# dans package.json) relaie automatiquement les requêtes vers http://localhost:5001.
#
# En production, indiquez l'URL du backend, par exemple :
# REACT_APP_API_URL=https://api.mon-chatbot-vocal.example.com
REACT_APP_API_URL=
