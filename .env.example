# TradingGraph AI - Configuration
# Copiez ce fichier en .env et remplissez vos clés

# --- LLM APIs (au moins une recommandée, sinon mode local) ---
# OpenAI - https://platform.openai.com/api-keys - Vision + Texte + Embeddings
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude - https://console.anthropic.com/settings/keys - Vision + Texte
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini - https://aistudio.google.com/app/apikey - Vision + Texte (gratuit généreux)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Embeddings locaux ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=5

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=False
