# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env

# Mode debug : 0 en production (défaut), 1 uniquement en développement
FLASK_DEBUG=0

# Serveur
HOST=0.0.0.0
PORT=5001

# Chemin vers le modèle Vosk (téléchargé par scripts/download_model.py)
MODEL_PATH=models/vosk-model-small-fr-0.22

# Dossier de stockage (historique JSON + documents Word générés)
DATA_DIR=data

# Taille maximale des fichiers audio uploadés (en mégaoctets)
MAX_CONTENT_LENGTH_MB=50

# Origines autorisées pour CORS (le frontend React en développement), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
