# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env

# Mode debug : 0 en production (défaut), 1 uniquement en développement
FLASK_DEBUG=0

# Serveur
HOST=0.0.0.0
PORT=5001

# Chemin vers le modèle Vosk (téléchargé par scripts/download_model.py)
MODEL_PATH=models/vosk-model-small-fr-0.22

# Dossier de stockage (base SQLite + documents générés)
DATA_DIR=data

# Base de données (défaut : SQLite dans DATA_DIR)
# Exemple PostgreSQL : postgresql+psycopg://user:pass@localhost:5432/chatbot
# DATABASE_URL=sqlite:///data/chatbot.db

# Langue reconnue (code utilisé dans les métadonnées des exports)
LANGUAGE=fr

# Taille maximale des fichiers audio uploadés (en mégaoctets)
MAX_CONTENT_LENGTH_MB=100

# Limitation de débit (rate limiting)
RATELIMIT_ENABLED=1
RATELIMIT_TRANSCRIBE=10/minute
RATELIMIT_DEFAULT=300/hour
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Origines autorisées pour CORS (le frontend React en développement), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
