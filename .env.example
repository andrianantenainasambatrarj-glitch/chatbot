# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env

# Mode debug : 0 en production (défaut), 1 uniquement en développement
FLASK_DEBUG=0

# Serveur
HOST=0.0.0.0
PORT=5001

# Dossier de stockage (base SQLite + uploads + documents générés)
DATA_DIR=data

# Base de données (défaut : SQLite dans DATA_DIR)
# Exemple PostgreSQL : postgresql+psycopg://user:pass@localhost:5432/chatbot
# DATABASE_URL=sqlite:///data/chatbot.db

# Taille maximale des fichiers audio uploadés (Mo)
MAX_CONTENT_LENGTH_MB=100
# Au-delà de ce seuil (Mo), la transcription devient une tâche asynchrone
ASYNC_THRESHOLD_MB=5
JOB_WORKERS=2

# Authentification JWT — OBLIGATOIRE de changer cette clé en production
# (générez-en une avec : python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_HOURS=168

# Moteur et langue par défaut (vosk | whisper ; codes ISO : fr, en, es, de...)
DEFAULT_ENGINE=vosk
DEFAULT_LANGUAGE=fr

# Modèles Vosk par langue (JSON langue -> chemin). Ajoutez les langues
# après les avoir téléchargés avec scripts/download_model.py --model <nom>
VOSK_MODELS={"fr": "models/vosk-model-small-fr-0.22"}

# Moteur Whisper optionnel (pip install -r requirements-whisper.txt)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Limitation de débit (rate limiting) ; utilisez Redis en multi-workers
RATELIMIT_ENABLED=1
RATELIMIT_TRANSCRIBE=10/minute
RATELIMIT_AUTH=20/hour
RATELIMIT_DEFAULT=300/hour
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Origines autorisées pour CORS (le frontend React en développement)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
